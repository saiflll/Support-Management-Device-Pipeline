FROM ghcr.io/chopratejas/headroom:latest

USER root

# models.py udah punya try/except untuk import numpy (jadi np=None).
# Tapi numpy TERINSTAL dengan binary X86_V2 → crash RuntimeError.
# Cukup uninstall numpy, biar ImportError ke-trigger → np=None → OK.
RUN apt-get update && apt-get install -y --no-install-recommends nginx && \
    rm -rf /var/lib/apt/lists/* && \
    rm -f /etc/nginx/sites-enabled/default && \
    pip uninstall -y numpy 2>&1 | tail -1

COPY nginx.conf /etc/nginx/nginx.conf

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh && chmod 644 /etc/nginx/nginx.conf

EXPOSE 8787 8788

ENTRYPOINT []
CMD ["/entrypoint.sh"]
