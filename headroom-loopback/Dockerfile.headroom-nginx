FROM ghcr.io/chopratejas/headroom:latest

USER root

# Masalah: Rust _core.so dikompilasi untuk CPU modern (SIGILL di KVM lawas)
# dan numpy pake binary X86_V2 (RuntimeError).
#
# Solusi:
# - Hapus _core.so → Python cari _core/__init__.py (shim) sebagai gantinya.
# - Hapus numpy → models.py punya try/except ImportError → np=None.
# - Pakai shim Python yg return default safe untuk semua module-level imports.
# Proxy jalan di Python-only degraded mode, kompresi tetap jalan via fallback.
RUN apt-get update && apt-get install -y --no-install-recommends nginx && \
    rm -rf /var/lib/apt/lists/* && \
    rm -f /etc/nginx/sites-enabled/default

COPY core_shim.py /tmp/core_shim.py
RUN pip uninstall -y numpy 2>&1 | tail -1 && \
    HEADROOM=$(python -c "
import importlib.util
spec = importlib.util.find_spec('headroom')
if spec and spec.submodule_search_locations:
    print(spec.submodule_search_locations[0])
") && \
    rm -f "$HEADROOM"/_core*.so && \
    rm -rf "$HEADROOM"/_core && \
    mkdir -p "$HEADROOM"/_core && \
    cp /tmp/core_shim.py "$HEADROOM"/_core/__init__.py && \
    rm /tmp/core_shim.py && \
    echo "OK: _core.so removed, Python shim installed at $HEADROOM/_core/"

COPY nginx.conf /etc/nginx/nginx.conf

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh && chmod 644 /etc/nginx/nginx.conf

EXPOSE 8787 8788

ENTRYPOINT []
CMD ["/entrypoint.sh"]
