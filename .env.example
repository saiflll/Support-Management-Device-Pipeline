# ============================================
# IoT Apps Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# Command: cp .env.example .env (Linux/Mac) or copy .env.example .env (Windows)

# ============================================
# 🔴 CRITICAL - MUST CHANGE FOR PRODUCTION
# ============================================

# Database Password - Use a strong password!
DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# JWT Secret Key - Generate a random 64-character hex string
# Example: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_TO_RANDOM_SECRET_KEY

# Telegram Bot Configuration
# Used by 'forward' service for sending alerts
TELE_BOT_ALRT=YOUR_ALERT_BOT_TOKEN_HERE
# Used by 'ota' service for login verification
TELE_BOT_OTA=YOUR_OTA_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=7412135090

# ============================================
# APPLICATION PORTS
# ============================================

# Main application port
PORT=8888

# Forwarder service port
FORWARDER_PORT=8888

# ============================================
# DATABASE CONFIGURATION
# ============================================

# SQLite Database Path (for local development)
DB_PATH=./database/iot_data.db

# PostgreSQL Database (for production)
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_NAME=servfi

# ============================================
# MQTT BROKER - LOCAL
# ============================================
# Local MQTT broker for data ingestion

MQTT_BROKER_URI=tcp://localhost:1883
MQTT_TOPIC=sensor/data/ingest
MQTT_USERNAME=forward
MQTT_PASSWORD=forward

# ============================================
# MQTT BROKER - CLOUD (FORWARDING)
# ============================================
# Cloud MQTT broker for data forwarding/publishing

MQTT_BROKER_PUB=tcp://emqx.miegacoan.id:1883
MQTT_TOPIC_PUB=sensor/data/ingest
MQTT_USERNAME_FOR=YOUR_USERNAME_HERE
MQTT_PASSWORD_FOR=YOUR_PASSWORD_HERE

# ============================================
# MQTT BROKER - DOCKER (FORMING SERVICE)
# ============================================
# MQTT configuration for forming service inside Docker

MQTT_HOST=emqx
MQTT_PORT=1883
MQTT_USER=forming
MQTT_PASSWORD=forming

# ============================================
# 🟢 OPTIONAL - Google Sheets Integration
# ============================================
# Only fill if you want to export data to Google Sheets
# Used by: forming service

# Base64-encoded Google Service Account JSON credentials
# To generate:
# 1. Go to Google Cloud Console
# 2. Create Service Account
# 3. Download JSON key file
# 4. Encode to base64: 
#    Linux/Mac: cat credentials.json | base64 -w 0
#    Windows: certutil -encode credentials.json temp.b64 && findstr /v /c:- temp.b64 > credentials.b64
# 5. Paste the result here
GOOGLE_SHEETS_CREDENTIALS=

# Google Spreadsheet ID from the URL
# Example: If URL is https://docs.google.com/spreadsheets/d/1ABC123XYZ/edit
# Then ID is: 1ABC123XYZ
GOOGLE_SPREADSHEET_ID=

# Sheet name within the spreadsheet
GOOGLE_SHEET_NAME=Production Data

# ============================================
# APPLICATION SETTINGS
# ============================================

# Timezone for all services
TZ=Asia/Jakarta

# Development Mode — set true untuk bypass auth di dashboard forwarder
# ⚠️  Pastikan DEV_MODE=false di production!
DEV_MODE=false

# ============================================
# CONFIGURATION NOTES
# ============================================
#
# 1. REQUIRED PARAMETERS (Must fill):
#    🔴 DB_PASSWORD - PostgreSQL password
#    🔴 JWT_SECRET_KEY - Secret key for JWT authentication
#    🔴 TELE_BOT_ALRT - Telegram bot token for the alert service
#    🔴 TELE_BOT_OTA - Telegram bot token for the OTA service
#    🔴 TELEGRAM_CHAT_ID - Your Telegram chat ID
#    🔴 MQTT_USERNAME_FOR - Cloud MQTT username
#    🔴 MQTT_PASSWORD_FOR - Cloud MQTT password
#
# 2. MQTT BROKER HIERARCHY:
#    📥 MQTT_BROKER_URI (Local) - Receives data from IoT devices
#    📤 MQTT_BROKER_PUB (Cloud) - Forwards data to cloud broker
#    🐳 MQTT_HOST (Docker) - Internal Docker container communication
#
# 3. DATABASE OPTIONS:
#    - DB_PATH: SQLite for local development/testing
#    - DB_HOST/DB_PORT/DB_USER/DB_PASSWORD: PostgreSQL for production
#
# 4. PORTS:
#    - PORT: Main backend API port
#    - FORWARDER_PORT: Forwarder service port (usually same as PORT)
#
# 5. Security Best Practices:
#    🔒 Never commit .env file to repository
#    🔒 Use strong passwords (16+ characters, mixed case, numbers, symbols)
#    🔒 Generate JWT_SECRET_KEY with: openssl rand -hex 32
#    🔒 Rotate secrets every 3-6 months
#    🔒 Keep backup of .env in secure encrypted location
#
# 6. Validation:
#    Run 'docker-compose config --quiet' to validate configuration
#
# 7. Documentation:
#    See docs/ENV_TEMPLATE.md for detailed explanation of all variables
#    See docs/SETUP_ENV.md for quick setup guide
#
# ============================================
