# ============================================
# IoT Apps ENV — Full Configuration
# ============================================
# Copy ke .env, ganti nilai dummy. Buat GitHub Secret ENV_FILE.
# ============================================

# ============================================
# 🔴 DATABASE (PostgreSQL)
# ============================================
DB_HOST=IOT-postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
DB_NAME=servfi
DB_PATH=./database/iot_data.db

# ============================================
# 🔴 AUTH / JWT
# ============================================
JWT_SECRET_KEY=ppa3-secret-jwt-2025
ATTEND_USER=ppa3
ATTEND_PASS=plan3ppa

# ============================================
# 🔴 TELEGRAM
# ============================================
TELE_BOT_ALRT=YOUR_ALERT_BOT_TOKEN_HERE
TELE_BOT_OTA=YOUR_OTA_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=7412135090

# ============================================
# 🔴 MQTT — LOCAL BROKER (EMQX)
# ============================================
MQTT_BROKER_URI=tcp://localhost:1883
MQTT_TOPIC=sensor/data/ingest
MQTT_USERNAME=forward
MQTT_PASSWORD=forward

# ============================================
# 🔴 MQTT — DOCKER INTERNAL (production + OTA)
# ============================================
MQTT_HOST=emqx
MQTT_PORT=1883
MQTT_USER=forming
MQTT_PASSWORD=forming
MQTT_PASS=forming

# ============================================
# 🔴 MQTT — CLOUD FORWARDING
# ============================================
MQTT_BROKER_PUB=tcp://emqx.miegacoan.id:1883
MQTT_TOPIC_PUB=sensor/data/ingest
MQTT_USERNAME_FOR=YOUR_USERNAME_HERE
MQTT_PASSWORD_FOR=YOUR_PASSWORD_HERE

CLOUD_MQTT_BROKER_URI=
CLOUD_MQTT_TOPIC_FORMING=prod/mdcw
CLOUD_MQTT_TOPIC_SP=
CLOUD_MQTT_USERNAME=
CLOUD_MQTT_PASSWORD=

# ============================================
# 🔴 EXTERNAL CONVEYOR DB (Scraper MySQL → PG)
# ============================================
PROD_DB_HOST=10.201.40.2
PROD_DB_PORT=3306
PROD_DB_USER=ppa
PROD_DB_PASSWORD=PestaPora123
PROD_DB_NAME=db_konveyor

# ============================================
# 🔴 REDIS
# ============================================
REDIS_URL=redis://redis:6379/0

# ============================================
# 🟢 OPTIONAL — Google Sheets
# ============================================
GOOGLE_SHEETS_CREDENTIALS=
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_NAME=Production Data

# ============================================
# 🟢 OPTIONAL — OTA Service
# ============================================
SERVER_NAME=ren_itdt_west
WEBHOOK_TOKEN=

# ============================================
# 🟢 OPTIONAL — Cloudflare Tunnel
# ============================================
CF_TUNNEL_TOKEN=eyJhIjoiYjg0...

# ============================================
# 🟢 OPTIONAL — Dev Console (ttyd sandbox)
# ============================================
DEV_PASS=devpass

# ============================================
# ⚙️ APPLICATION SETTINGS
# ============================================
PORT=8888
FORWARDER_PORT=8888
TZ=Asia/Jakarta
DEV_MODE=false
DEBUG_MODE=1
