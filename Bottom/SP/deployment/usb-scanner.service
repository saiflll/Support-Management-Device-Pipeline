[Unit]
Description=USB Hybrid Automation Gateway Engine (HID + VCP)
After=network.target

[Service]
Type=simple
# CATATAN: keyboard library di Linux membutuhkan akses root untuk membaca /dev/input/
User=root
WorkingDirectory=/opt/usb_scanner
ExecStart=/usr/bin/python3 -u usb_scanner.py
Restart=always
RestartSec=5
# Output logs ke syslog agar mudah didebug
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=usb-scanner

[Install]
WantedBy=multi-user.target
